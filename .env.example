# Salin file ini menjadi .env.local, lalu isi nilainya.
# Jangan commit .env.local. Sebagian besar variabel di bawah hanya dibaca di
# server; dua variabel NEXT_PUBLIC_ (Supabase Auth) memang untuk browser dan
# tidak boleh berisi kunci rahasia.

# Kunci API layanan AI (rahasia).
AI_API_KEY=

# Base URL endpoint yang kompatibel dengan Chat Completions API,
# tanpa bagian "/chat/completions". Contoh bentuk: https://host/v1
AI_BASE_URL=

# Nama model yang dipakai untuk menyusun soal.
AI_MODEL=

# Rahasia untuk mengenkripsi token kuis (kunci jawaban).
# Buat nilai acak panjang, misalnya: openssl rand -base64 32
KUIS_SECRET=

# Proyek Supabase (Project Settings -> API).
# Service role key HANYA untuk server dan tidak boleh dipakai di browser.
# Database diakses dari server memakai kunci ini.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth untuk panel guru. Nilai url sama dengan SUPABASE_URL, sedangkan
# anon key (Project Settings -> API -> anon public) memang untuk browser karena
# hanya dipakai login/logout. Jangan pernah menaruh service role key di sini.
# Akses panel hanya untuk pengguna dengan app_metadata {"role":"guru"}.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Token masuk kelas tidak lagi diatur di sini. Guru membuat dan mengganti token
# per kelas dari panel guru (/guru/token); token disimpan di tabel token_kelas
# pada Supabase.
